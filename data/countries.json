      "tag": "v7.5.0",
      "tagObject": "50a8bff005239b0d2d661254094dedb9c75dbef3",
      "commit": "7aa5b2bdddd570ece62c812c0cb588ccdc099e2e",
      "archiveUrl": "https://codeload.github.com/lipis/flag-icons/tar.gz/refs/tags/v7.5.0",
      "archiveSha256": "5502d1bb0bda9f258d726d3c084a2d57a07cfdfa6d2ed18cbb5a1ee11b307778",
      "variant": "4x3",
      "license": "MIT"
    },
    "regions": [
      "africa",
      "asia",
      "europe",
      "north-america",
      "south-america",
      "oceania"
    ],
    "policy": {
      "scope": "Codes come from flag-icons' country.json, filtered to `iso: true` (ISO 3166-1 alpha-2). Kept: sovereign states and inhabited dependencies/territories whose flag is visually distinct from every other kept flag. Non-ISO codes (subdivisions such as gb-eng/es-ct, supranational flags such as eu/un/arab, placeholders such as xx, and Kosovo `xk`, which has no ISO 3166-1 code) are dropped by the ISO filter. Every other dropped ISO code is listed in `meta.excluded` with its reason.",
      "regionBasis": "UN M49 geoscheme (Statistics Division \"Standard country or area codes for statistical use\"). M49 Africa, Asia, Europe and Oceania map 1:1. M49 Americas is split: Northern America, Central America and the Caribbean -> north-america; South America -> south-america. Upstream flag-icons `continent` values are ignored.",
      "transcontinental": {
        "ru": "europe (M49 Eastern Europe)",
        "tr": "asia (M49 Western Asia)",
        "cy": "asia (M49 Western Asia), although an EU member",
        "am": "asia (M49 Western Asia)",
        "az": "asia (M49 Western Asia)",
        "ge": "asia (M49 Western Asia)",
        "kz": "asia (M49 Central Asia)",
        "eg": "africa (M49 Northern Africa)",
        "id": "asia (M49 South-eastern Asia)",
        "tl": "asia (M49 South-eastern Asia)",
        "pg": "oceania (M49 Melanesia)",
        "pa": "north-america (M49 Central America)",
        "tt": "north-america (M49 Caribbean; upstream says South America)",
        "aw": "north-america (M49 Caribbean; upstream says South America)",
        "cw": "north-america (M49 Caribbean; upstream says South America)",
        "gl": "north-america (M49 Northern America)",
        "cx": "oceania (M49 Australia and New Zealand; upstream says Asia)",
        "cc": "oceania (M49 Australia and New Zealand; upstream says Asia)",
        "tw": "asia (not listed in M49; placed by geography, Eastern Asia)"
      },
      "sovereignty": "`sovereign` is true iff the entry is a UN member state or a UN non-member observer state (ps, va). Everything else is false. No judgement about recognition is made beyond that rule.",
      "parentCode": "`parentCode` is the lowercase code of the single UN-member state that de facto administers a dependency/territory (for Cook Islands and Niue: the state it is in free association with). It is null for sovereign entries and for entries whose own status is disputed with no single administering state (tw, eh). A sovereignty claim by another state does not change `parentCode` (see `contested`).",
      "naming": "`name` is the common English short name, without political qualifiers, with diacritics kept (e.g. Côte d'Ivoire, Türkiye). `aliases` are former, long-form or colloquial English names used only for typing-mode search; they are not endorsements.",
      "contested": {
        "tw": "Taiwan: not a UN member or observer -> sovereign false. Status disputed, no single administering UN-member state -> parentCode null. Name \"Taiwan\" with no aliases.",
        "eh": "Western Sahara: non-self-governing territory; administration divided between Morocco and the Sahrawi Republic -> sovereign false, parentCode null. Name \"Western Sahara\" with no aliases. Flag as shipped by flag-icons.",
        "ps": "Palestine: UN non-member observer state -> sovereign true, parentCode null. Name \"Palestine\", alias \"State of Palestine\".",
        "va": "Vatican City: UN non-member observer state (as the Holy See) -> sovereign true. Alias \"Holy See\".",
        "xk": "Kosovo: no ISO 3166-1 code (flag-icons marks it `iso: false`) -> excluded by the scope rule, not by a judgement about its status.",
        "fk": "Falkland Islands: administered by the United Kingdom, sovereignty claimed by Argentina -> sovereign false, parentCode gb (administering state). Alias \"Malvinas\", following the UN name \"Falkland Islands (Malvinas)\".",
        "gi": "Gibraltar: administered by the United Kingdom, sovereignty claimed by Spain -> parentCode gb.",
        "hk": "Hong Kong: special administrative region of China -> sovereign false, parentCode cn.",
        "mo": "Macau: special administrative region of China -> sovereign false, parentCode cn.",
        "ck": "Cook Islands: self-governing in free association with New Zealand, not a UN member -> sovereign false, parentCode nz.",
        "nu": "Niue: self-governing in free association with New Zealand, not a UN member -> sovereign false, parentCode nz.",
        "cy": "Cyprus: one entry for the UN member state; Northern Cyprus has no ISO code and is not in the source list.",
        "io": "British Indian Ocean Territory: excluded because it has no permanent population (see `meta.excluded`), not because of the Mauritius-UK sovereignty question."
      },
      "duplicateFlags": "A territory is excluded when flag-icons ships its parent's flag for it (byte-identical once the SVG `id` is normalised, or a colour-shade variant of the same design), because the quiz could not tell the two apart. These are listed in `meta.excluded`."
    },
    "excluded": {
      "aq": "uninhabited: Antarctica, no permanent population",
      "bl": "duplicate flag: flag-icons ships the flag of France (fr)",
      "bq": "duplicate flag: flag-icons ships the flag of the Netherlands (nl)",
      "bv": "uninhabited: Bouvet Island, no permanent population",
      "gf": "duplicate flag: flag-icons ships the flag of France (fr)",
      "gp": "duplicate flag: flag-icons ships the flag of France (fr)",
      "gs": "uninhabited: South Georgia and the South Sandwich Islands, no permanent population (only rotating government and research staff)",
      "hm": "uninhabited: Heard Island and McDonald Islands, no permanent population",
      "io": "uninhabited: British Indian Ocean Territory, no permanent population (military and contractor staff only)",
      "mf": "duplicate flag: flag-icons ships the flag of France (fr)",
      "pm": "duplicate flag: flag-icons ships the flag of France (fr)",
      "re": "duplicate flag: flag-icons ships the flag of France (fr)",
      "sh": "duplicate flag: flag-icons ships the flag of the United Kingdom (gb)",
      "sj": "duplicate flag: flag-icons ships the flag of Norway (no), differing only in colour shade",
      "tf": "uninhabited: French Southern and Antarctic Lands, no permanent population",
      "um": "uninhabited: United States Minor Outlying Islands, no permanent population",
      "wf": "duplicate flag: flag-icons ships the flag of France (fr)",
      "yt": "duplicate flag: flag-icons ships the flag of France (fr)"
    }
  },
