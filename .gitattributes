# Normalise line endings to LF everywhere (repo and checkout), so
# test/countries.test.js's byte-for-byte regeneration check also holds on
# Windows clones with core.autocrlf.
* text=auto eol=lf
*.svg text eol=lf
*.json text eol=lf
*.js text eol=lf
*.md text eol=lf
*.png binary
# Vendored fonts and their license stay byte-identical to upstream, with no
# line-ending normalisation: THIRD_PARTY_NOTICES.md and sw.js record their
# SHA-256s.
fonts/* -text
