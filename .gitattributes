# Normalise line endings to LF everywhere (repo and checkout), so
# test/countries.test.js's byte-for-byte regeneration check also holds on
# Windows clones with core.autocrlf.
* text=auto eol=lf
*.svg text eol=lf
*.json text eol=lf
*.js text eol=lf
*.md text eol=lf
*.png binary
# Vendored fonts and their license stay byte-identical to upstream (the
# OFL.txt has CRLF endings; THIRD_PARTY_NOTICES.md records its SHA-256).
fonts/* -text
